rules_version = '2';

// Regras de segurança do banco (Cloud Firestore) da plataforma Blue Village.
// Copie TODO este conteúdo em: Firebase Console > Firestore Database > Regras > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function caminho(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    function temPerfil() { return request.auth != null && exists(caminho('users', request.auth.uid)); }
    function perfil() { return get(caminho('users', request.auth.uid)).data; }
    function ativo() { return temPerfil() && perfil().ativo == true; }
    function admin() { return ativo() && perfil().perfil == 'Administrador'; }
    function semBootstrap() { return !exists(caminho('meta', 'bootstrap')); }
    function bootstrapNesteLote() { return semBootstrap() && existsAfter(caminho('meta', 'bootstrap')); }

    // Marca de "primeiro acesso já feito" (criação do admin)
    match /meta/{id} {
      allow get: if true;
      allow create: if id == 'bootstrap' && request.auth != null && semBootstrap()
        && getAfter(caminho('users', request.auth.uid)).data.perfil == 'Administrador';
    }

    // Usuário (login) -> e-mail interno. Leitura só por nome exato (não lista).
    match /logins/{u} {
      allow get: if true;
      allow create: if u == 'admin' && request.auth != null && bootstrapNesteLote();
      allow create, update, delete: if admin();
    }

    // Perfis dos usuários
    match /users/{uid} {
      allow read: if ativo() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid && bootstrapNesteLote()
        && request.resource.data.perfil == 'Administrador' && request.resource.data.ativo == true;
      allow create, update, delete: if admin();
    }

    // Dados do condomínio: qualquer usuário ativo
    match /lanc/{id}   { allow read, write: if ativo(); }
    match /manut/{id}  { allow read, write: if ativo(); }
    match /forn/{id}   { allow read, write: if ativo(); }
    match /config/{id} { allow read, write: if ativo(); }
    match /logs/{id} {
      allow read, create: if ativo();
      allow delete: if admin();
    }
  }
}
